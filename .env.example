# ===================================================================
# CodeGuide Starter Fullstack - Environment Variables
# ===================================================================
# Copy this file to .env and modify as needed for your environment
# Never commit the actual .env file to version control
# ===================================================================

# ===================================================================
# Database Configuration
# ===================================================================
# PostgreSQL database connection string
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres

# Individual database variables (used by Docker Compose)
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Database host and port (if using external database)
# DB_HOST=localhost
# DB_PORT=5432

# ===================================================================
# Authentication Configuration
# ===================================================================
# Secret key for Better Auth - generate a secure 32+ character key
# Use: openssl rand -hex 32 or node -e "console.log(crypto.randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=your_secret_key_here_minimum_32_characters_long

# Authentication URLs - update these for production deployments
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# ===================================================================
# Application Configuration
# ===================================================================
# Node.js environment (development, production)
NODE_ENV=development

# Application port (defaults to 3000 if not specified)
# PORT=3000

# Application URL for building absolute URLs
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===================================================================
# Optional: External Services
# ===================================================================
# Email service configuration (for password reset, email verification)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@yourdomain.com

# OAuth providers (optional - for social login)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# ===================================================================
# Optional: Analytics and Monitoring
# ===================================================================
# Google Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Sentry for error tracking
# SENTRY_DSN=https://your-sentry-dsn-here

# ===================================================================
# Optional: Development Tools
# ===================================================================
# Enable debug mode for additional logging
# DEBUG=false

# Enable source maps in development (disabled in production for security)
# NEXT_PUBLIC_SOURCE_MAPS=true

# ===================================================================
# Production Security Headers (optional)
# ===================================================================
# Content Security Policy
# NEXT_PUBLIC_CSP_HEADER=default-src 'self'

# Additional security headers can be configured here
# ===================================================================

# ===================================================================
# Deployment-Specific Variables
# ===================================================================
# For Vercel deployment, these will be set automatically
# For Docker deployment, ensure these match your container configuration

# Example production values:
# NODE_ENV=production
# BETTER_AUTH_URL=https://yourdomain.com
# NEXT_PUBLIC_BETTER_AUTH_URL=https://yourdomain.com
# NEXT_PUBLIC_APP_URL=https://yourdomain.com
# DATABASE_URL=postgresql://user:password@your-db-host:5432/database