# =============================================================================
# CODEGUIDE STARTER FULLSTACK - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and modify as needed for your environment
# NEVER commit the .env file to version control
# =============================================================================

# =============================================================================
# NODE ENVIRONMENT
# =============================================================================
# Environment: development, production, test
NODE_ENV=development

# Port for the Next.js application (default: 3000)
PORT=3000

# Hostname (use 0.0.0.0 for Docker)
HOSTNAME=0.0.0.0

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL connection string
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres

# PostgreSQL Docker container configuration
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Alternative database configurations (uncomment if needed)
# DATABASE_URL=postgresql://username:password@your-host:5432/your-database
# For Railway, Vercel, or other providers, use their provided connection string

# =============================================================================
# AUTHENTICATION CONFIGURATION
# =============================================================================
# Secret key for signing authentication tokens (MUST be at least 32 characters)
# Generate a secure secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=your_super_secure_secret_key_here_minimum_32_characters_long

# Base URL for Better Auth server-side operations
BETTER_AUTH_URL=http://localhost:3000

# Public URL for Better Auth client-side operations
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# =============================================================================
# OAUTH PROVIDERS (Optional - Uncomment and configure as needed)
# =============================================================================
# Google OAuth (get keys from: https://console.cloud.google.com/)
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth (create app at: https://github.com/settings/applications/new)
# GITHUB_CLIENT_ID=your_github_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret

# =============================================================================
# EMAIL CONFIGURATION (Optional - For password resets, etc.)
# =============================================================================
# SMTP configuration for transactional emails
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password

# Email sending configuration
# EMAIL_FROM=noreply@yourdomain.com
# EMAIL_REPLY_TO=support@yourdomain.com

# =============================================================================
# REDIS CONFIGURATION (Optional - For session storage, caching)
# =============================================================================
# Redis connection string (uncomment if using Redis)
# REDIS_URL=redis://localhost:6379

# =============================================================================
# FILE UPLOAD CONFIGURATION (Optional)
# =============================================================================
# AWS S3 configuration for file uploads
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-s3-bucket-name

# Cloudinary configuration (alternative to S3)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# =============================================================================
# ANALYTICS & MONITORING (Optional)
# =============================================================================
# Google Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Sentry error monitoring
# SENTRY_DSN=your_sentry_dsn

# =============================================================================
# DEVELOPMENT & DEBUGGING
# =============================================================================
# Enable debug logging (true/false)
DEBUG=false

# Enable CORS for development (comma-separated list of origins)
# CORS_ORIGIN=http://localhost:3001,http://localhost:3002

# =============================================================================
# SECURITY & PERFORMANCE
# =============================================================================
# JWT token expiration (in seconds, default: 15 minutes)
# JWT_EXPIRES_IN=900

# Session cookie settings
# SESSION_MAX_AGE=86400  # 24 hours in seconds
# SESSION_COOKIE_NAME=auth-token

# Rate limiting (requests per minute)
# RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# FEATURES FLAGS (Optional)
# =============================================================================
# Enable/disable specific features
# ENABLE_EMAIL_VERIFICATION=true
# ENABLE_OAUTH_PROVIDERS=false
# ENABLE_FILE_UPLOADS=false
# ENABLE_ANALYTICS=false

# =============================================================================
# PRODUCTION OVERRIDES
# =============================================================================
# These values will be overridden by your hosting provider in production
# Make sure to set these in your hosting platform's dashboard

# Example Vercel environment variables:
# DATABASE_URL=postgresql://user:pass@host:5432/db
# BETTER_AUTH_SECRET=production_secret_key
# BETTER_AUTH_URL=https://yourdomain.vercel.app
# NEXT_PUBLIC_BETTER_AUTH_URL=https://yourdomain.vercel.app

# Example Railway environment variables:
# PORT=10000
# DATABASE_URL=postgresql://user:pass@containers-us-west-1.railway.app:7923/railway

# =============================================================================
# NOTES & BEST PRACTICES
# =============================================================================
# 1. Always use strong, unique secrets for production
# 2. Never commit .env files to version control
# 3. Use different values for development and production
# 4. Regularly rotate your secret keys
# 5. Use environment-specific databases when possible
# 6. Enable HTTPS in production and update auth URLs accordingly
# =============================================================================